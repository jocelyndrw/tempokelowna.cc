---
import sponsors from '../data/sponsors.json';

const goldPartners = sponsors.filter((sponsor) => sponsor.tier === 'Gold Partner');
const starSupporters = sponsors.filter((sponsor) => sponsor.tier === 'Star Supporters');
---
<section class="section section--sponsors" aria-labelledby="sponsors-title">
  <div class="section__inner">
    <h2 id="sponsors-title" class="section__heading">2026 Partners and Supporters</h2>
    <div class="sponsor-tier sponsor-tier--gold">
      <h3>Gold Partner</h3>
      {goldPartners.map((sponsor) => (
        <a class="sponsor-link sponsor-link--gold" href={sponsor.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${sponsor.name}`}>
          <img src={sponsor.logo} alt={sponsor.alt} width={sponsor.width} height={sponsor.height} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <div class="sponsor-tier sponsor-tier--supporters">
      <h3>Star Supporters</h3>
      <div class="supporter-list">
        {starSupporters.map((sponsor) => (
          <a class="sponsor-link" href={sponsor.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${sponsor.name}`}>
            <img src={sponsor.logo} alt={sponsor.alt} width={sponsor.width} height={sponsor.height} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
