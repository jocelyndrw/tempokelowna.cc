---
import site from '../data/site.json';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <a class="footer-social" href={site.links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Tempo Cycling Club on Instagram">
      <img src={site.instagramIcon.src} alt="" width="100" height="100" loading="lazy" />
    </a>
    <a class="footer-email" href={`mailto:${site.contactEmail}`} aria-label={`Email ${site.contactEmail}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3.5 5.5h17v13h-17z" />
        <path d="m4 6 8 6.25L20 6" />
      </svg>
    </a>
  </div>
</footer>
